
{
    "productName": "FinanceApp",
    "version": "0.1.0",
    "identifier": "com.financeapp.desktop",
    "build": {
      "beforeDevCommand": "npm run dev",
      "beforeBuildCommand": "npm run build",
      "devUrl": "http://localhost:5174",
      "frontendDist": "../dist"
    },
    "app": {
      "withGlobalTauri": true,
      "windows": [
        {
          "width": 1280,
          "height": 800,
          "resizable": true
        }
      ],
      "security": {
        "csp": null
      }
    },
    "bundle": {
      "active": true,
      "targets": ["msi"],
      "category": "Finance",
      "resources": [
        "resources/financeapp-backend.exe"
      ],
      "publisher": "FinanceApp",
      "createUpdaterArtifacts": true
    },
    "plugins": {
      "updater": {
        "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Q0Y1NTk1MTIzQkU0NjkKUldScDVEc1NsVlhQS1NqSFpLU2lBVEsyQ0lJK0Z2TXgzY2V2VXFGSXczVzdHL1FON0tidE1jLzkK",
        "endpoints": [
          "https://github.com/WilhelmBuitrago/financeapp/releases/latest/download/latest.json"
        ],
        "windows": {
          "installMode": "passive"
        }
      }
    }
  }
  