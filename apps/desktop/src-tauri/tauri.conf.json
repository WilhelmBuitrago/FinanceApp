
{
    "productName": "FinanceApp",
    "version": "0.1.0",
    "identifier": "com.financeapp.desktop",
    "build": {
      "beforeDevCommand": "npm run dev",
      "beforeBuildCommand": "npm run build",
      "devUrl": "http://localhost:5174",
      "frontendDist": "../dist"
    },
    "app": {
      "withGlobalTauri": true,
      "windows": [
        {
          "width": 1280,
          "height": 800,
          "resizable": true
        }
      ],
      "security": {
        "csp": null
      }
    },
    "bundle": {
      "active": true,
      "targets": ["msi"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "category": "Finance",
      "resources": [
        "resources/financeapp-backend.exe"
      ],
      "publisher": "FinanceApp",
      "createUpdaterArtifacts": true
    },
    "plugins": {
      "updater": {
        "pubkey": "untrusted comment: minisign public key: 29CF5595123BE469\nRWRp5DsSlVXPKSjHZKSiATK2CII+FvMx3cevUqFIw3W7G/QN7KbtMc/9",
        "endpoints": [
          "https://github.com/WilhelmBuitrago/financeapp/releases/latest/download/latest.json"
        ],
        "windows": {
          "installMode": "passive"
        }
      }
    }
  }
  